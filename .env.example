# =====================================================================
# Customer Support Ticket Triage System - Environment Variables
# =====================================================================

# 1. Supabase PostgreSQL Database (Required for persistent cloud database)
# Obtain these from your Supabase Project Settings -> API: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# 2. Google Gemini API (Server-side only)
# AI Studio automatically injects this at runtime from user secrets.
# For local or external deployment, obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Application URL (Optional, for OAuth / canonical redirects)
APP_URL="http://localhost:3000"
